{
        "$schema": "node_modules/wrangler/config-schema.json",
        "name": "designer",
        "compatibility_date": "2025-08-03",
        "main": "./src/index.tsx",
        "durable_objects": {
                "bindings": [
                        {
                                "name": "v1",
                                "class_name": "PartyServer",
                        },
                ],
        },
        "r2_buckets": [
                {
                        "binding": "r2",
                        "bucket_name": "grid",
                },
        ],
        "migrations": [
                {
                        "tag": "v1",
                        "new_sqlite_classes": ["PartyServer"],
                },
        ],
}
